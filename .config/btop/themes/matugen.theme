# Main background and foreground
theme[main_bg] = "#171216"
theme[main_fg] = "#ebdfe6"

# Title and headings
theme[title] = "#ebdfe6"
theme[hi_fg] = "#efb4e9"

# Selected/Active items
theme[selected_bg] = "#efb4e9"
theme[selected_fg] = "#4b1f4b"

# Inactive items
theme[inactive_fg] = "#d1c3cc"

# Graph/Chart colors
theme[graph_text] = "#ebdfe6"
theme[meter_bg] = "#4e444b"
theme[proc_misc] = "#f6b8aa"
theme[proc_start] = "#efb4e9"
theme[proc_mid] = "#643663"
theme[proc_end] = "#d9bfd3"

# Cpu/Mem/Disk graphs
theme[cpu_start] = "#efb4e9"
theme[cpu_mid] = "#643663"
theme[cpu_end] = "#f6b8aa"

theme[mem_start] = "#efb4e9"
theme[mem_mid] = "#643663"
theme[mem_end] = "#f6b8aa"

theme[net_start] = "#efb4e9"
