#!/usr/bin/env bash
set -Eeuo pipefail

# Paths
DOTFILES_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
PKGLIST="$DOTFILES_DIR/pkglist.txt"
STOW_PACKAGE="home"

# Logging
log() {
    printf '\033[1;32m==>\033[0m %s\n' "$*"
}

warn() {
    printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2
}

die() {
    printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2
    exit 1
}

# Validate environment
((EUID != 0)) || die "Do not run this script as root; it uses sudo where needed."
command -v pacman >/dev/null 2>&1 || die "This installer requires Arch Linux."
command -v sudo >/dev/null 2>&1 || die "sudo is required."
[[ -f "$PKGLIST" ]] || die "Missing package list: $PKGLIST"
[[ -d "$DOTFILES_DIR/$STOW_PACKAGE" ]] ||
    die "Missing Stow package directory: $DOTFILES_DIR/$STOW_PACKAGE"

# Install prerequisites, including GNU Stow.
# -Syu avoids partial upgrades and stale-database 404s on fresh installs.
log "Installing prerequisite packages..."
sudo pacman -Syu --needed git base-devel stow

# Install paru if missing
if ! command -v paru >/dev/null 2>&1; then
    log "Building paru from the AUR..."

    BUILD_DIR="$(mktemp -d)"
    trap 'rm -rf -- "${BUILD_DIR:-}"' EXIT

    git clone https://aur.archlinux.org/paru.git "$BUILD_DIR/paru"

    (
        cd "$BUILD_DIR/paru"
        makepkg -si
    )

    rm -rf -- "$BUILD_DIR"
    trap - EXIT
fi

# Install packages from pkglist.txt
log "Installing packages from pkglist.txt..."

mapfile -t PACKAGES < <(
    grep -Ev '^[[:space:]]*(#|$)' "$PKGLIST" |
        sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
)

if ((${#PACKAGES[@]} > 0)); then
    paru -S --needed "${PACKAGES[@]}"
fi

# Deploy home-directory dotfiles using GNU Stow.
# Everything under home/ mirrors $HOME; the rest of the repo is tooling.
# Create these as real directories first so Stow links the individual app
# directories inside them instead of replacing the directories themselves.
log "Deploying dotfiles with GNU Stow..."

mkdir -p "$HOME/.config" "$HOME/.local/bin"

# Scripts linked into ~/.local/bin must be executable. The symlinks always look
# the same; what matters is the mode of the file in the repo.
if [[ -d "$DOTFILES_DIR/$STOW_PACKAGE/.local/bin" ]]; then
    find "$DOTFILES_DIR/$STOW_PACKAGE/.local/bin" -maxdepth 1 -type f \
        ! -perm -u+x -exec chmod +x -- {} +
fi

# The repository wins on conflicts. Stow itself refuses to touch existing files,
# so move anything that is in the way into a timestamped backup directory first
# (nothing is deleted), then let Stow create the links.
BACKUP_DIR="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
STOW_ROOT="$DOTFILES_DIR/$STOW_PACKAGE"
backed_up=0

while IFS= read -r -d '' src; do
    rel="${src#"$STOW_ROOT"/}"
    dest="$HOME/$rel"

    # Drop stale symlinked parents that point into this repo outside home/
    # (e.g. a folded ~/.config/fish from an older layout).
    parent="$(dirname -- "$rel")"
    while [[ "$parent" != "." ]]; do
        if [[ -L "$HOME/$parent" ]]; then
            link_target="$(readlink -m -- "$HOME/$parent")"
            if [[ "$link_target" == "$DOTFILES_DIR"/* && "$link_target" != "$STOW_ROOT"/* ]]; then
                rm -- "$HOME/$parent"
            fi
        fi
        parent="$(dirname -- "$parent")"
    done

    [[ -e "$dest" || -L "$dest" ]] || continue

    # Already points at the repo file (directly or through a linked parent).
    [[ "$(readlink -m -- "$dest")" == "$(readlink -m -- "$src")" ]] && continue

    # Stale symlink into this repo (e.g. from an older layout): just drop it.
    if [[ -L "$dest" && "$(readlink -m -- "$dest")" == "$DOTFILES_DIR"/* ]]; then
        rm -- "$dest"
        continue
    fi

    mkdir -p -- "$BACKUP_DIR/$(dirname -- "$rel")"
    mv -- "$dest" "$BACKUP_DIR/$rel"
    warn "Replaced existing $dest (backup: $BACKUP_DIR/$rel)"
    backed_up=1
done < <(find "$STOW_ROOT" \( -type f -o -type l \) -print0)

if ((backed_up)); then
    log "Replaced files were moved to $BACKUP_DIR"
fi

stow \
    --dir="$DOTFILES_DIR" \
    --target="$HOME" \
    --restow \
    "$STOW_PACKAGE" ||
    die "Stow failed even after moving conflicting files aside."

log "Dotfiles installation complete."
